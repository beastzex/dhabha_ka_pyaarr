# ==============================================================================
# DHABA TRIAGE SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running in LIVE mode:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# SECURITY NOTICE:
#   - NEVER commit the actual '.env' file or any secret keys to version control.
#   - '.env' and all key/credential files are strictly excluded via .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION EXECUTION MODE
# ------------------------------------------------------------------------------
# Options:
#   'replay' -> Zero API keys required. Uses verified fixture responses in
#               app/fixtures/replay_responses.json. 100% deterministic, instant,
#               and zero token costs. (Default if no API keys are provided)
#   'live'   -> Dispatches prompts to live LLM providers using the automated
#               fallback cascade (Gemini -> Claude -> OpenAI -> Groq).
TRIAGE_MODE=replay

# ------------------------------------------------------------------------------
# 2. MULTI-PROVIDER LLM FALLBACK CASCADE
# ------------------------------------------------------------------------------
# The service implements an automated multi-provider resilience cascade:
#   1. Google Gemini (Primary)
#   2. Anthropic Claude (1st Fallback)
#   3. OpenAI (2nd Fallback)
#   4. Groq GPT OSS 120B (3rd Fallback)
#
# If a provider experiences rate limits (429), server timeouts, or 5xx outages,
# the service logs a fallback event and seamlessly routes the ticket to the next
# provider in the sequence. If all live providers fail, the service engages
# graceful degradation (needs_human=True, confidence=0.0) without crashing.
# ------------------------------------------------------------------------------

# [PRIMARY] Google Gemini API Key & Model
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# [FALLBACK 1] Anthropic Claude API Key & Model
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# [FALLBACK 2] OpenAI API Key & Model
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# [FALLBACK 3] Groq API Key & Model (GPT OSS 120B)
# Get key: https://console.groq.com/keys
# Note: Groq's open-weights GPT OSS 120B provides ultra-fast inference with generous free-tier limits
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. SERVICE RUNTIME & FINANCIAL POLICY SETTINGS
# ------------------------------------------------------------------------------
# SQLite persistence database path for ticket audit records and idempotency locks
DB_PATH=triage_state.db

# Confidence threshold for automated processing (0.0 to 1.0).
# Classifications with confidence < 0.75 are flagged for human supervisor review.
CONFIDENCE_THRESHOLD=0.75
